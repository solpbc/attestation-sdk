# CI/build image for the sol portable nvattest rail.
# manylinux_2_28 = AlmaLinux 8 userland, glibc 2.28 floor — matches upstream RHEL8 support intent.
ARG CI_IMAGE
FROM ${CI_IMAGE}

RUN dnf install -y \
    openssl-devel libcurl-devel libxml2-devel xmlsec1-devel xmlsec1-openssl-devel \
    zlib-devel xz git patch perl-core \
  && dnf clean all

ENV RUSTUP_HOME="/usr/local/rustup"
RUN export CARGO_HOME="/usr/local/cargo" \
  && curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.88.0 \
  && chmod -R a+rX "$CARGO_HOME" "$RUSTUP_HOME"
ENV PATH="/usr/local/cargo/bin:${PATH}"
