# CI/build image for the sol portable nvattest rail.
# manylinux_2_28 = AlmaLinux 8 userland, glibc 2.28 floor — matches upstream RHEL8 support intent.
# TODO(L1): pin by digest + pin the rust toolchain per org release-rail conventions.
FROM quay.io/pypa/manylinux_2_28_x86_64

RUN dnf install -y \
    openssl-devel libcurl-devel libxml2-devel xmlsec1-devel xmlsec1-openssl-devel \
    zlib-devel xz git patch perl-core \
  && dnf clean all

RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.85.0
ENV PATH="/root/.cargo/bin:${PATH}"
